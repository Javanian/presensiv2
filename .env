# Shared Docker Compose defaults for local development.
COMPOSE_PROJECT_NAME=presensiv2

DB_NAME=ptssb
DB_SCHEMA=hris_ssb
DB_USER=presensiv2
DB_PASSWORD=presensiv2pass
DB_HOST_PORT=5433

BACKEND_PORT=8000
WEB_PORT=5173

# Web uses the Vite dev proxy by default, so it works from localhost or LAN IP.
WEB_API_BASE_URL=/api
WEB_API_PROXY_TARGET=http://backend:8000

# Expo/mobile uses auto discovery from the Expo dev server host.
# Set to a full URL (http://IP:PORT) to override, or "auto" for auto detection.
EXPO_PUBLIC_API_BASE_URL=100.90.247.46
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_TIMEOUT=10000